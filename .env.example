# ==============================================================================
# LendLoop Environment Configuration
# ==============================================================================

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Convex BaaS
NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-convex-deployment

# n8n Automation & Security
# Shared HMAC Secret used for bidirectional HMAC-SHA256 signature verification
LENDLOOP_WEBHOOK_SECRET=lendloop_super_secret_hmac_signing_key_32bytes_min
N8N_WEBHOOK_URL=http://localhost:5678/webhook/request-notification
CONVEX_SITE_URL=https://your-convex-deployment.convex.site

# n8n Docker Setup
N8N_ENCRYPTION_KEY=lendloop_n8n_master_encryption_key_at_least_32_characters
NODE_FUNCTION_ALLOW_BUILTIN=crypto,buffer
